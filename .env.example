# 复制为 .env 并填入真实值。绝不要把 .env 提交到版本库。

# 项目根与数据目录(scripts/launch.sh 会自动 export,一般不用手改)
# AGENT_PROJECT_ROOT=/Users/you/Desktop/my agent
# AGENT_LOG_DIR=/Users/you/Desktop/my agent/logs

# 选择模型 provider:mock(默认,无需 key) / openai / claude / deepseek / ollama / router
AGENT_PROVIDER=mock

# 具体模型 id(优先于 provider): deepseek-v4-flash / deepseek-v4-pro / gpt-4o-mini 等
# AGENT_MODEL=deepseek-v4-flash

# 各家 API Key(用哪个填哪个)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# 可选模型名覆盖
# OPENAI_MODEL=gpt-4o-mini
# CLAUDE_MODEL=claude-sonnet-4-20250514
# DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 Ollama(OpenAI 兼容 /v1,需先 ollama serve)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 治理档位:conservative | balanced | aggressive
# AGENT_GOVERNANCE_MODE=balanced

# 开发期在控制台回显 trace
# AGENT_TRACE_ECHO=1

# 最大步数(防止单任务死循环,默认 20)
# AGENT_MAX_STEPS=20
# AGENT_CAPTAIN_MAX_STEPS=8

# 金额上限(USD),防止烧爆额度;注释掉则无限制
# AGENT_MAX_COST_USD=0.10

# ── 专属化 ────────────────────────────────────────────────────────────────────
# 偏好自动沉淀:会话后抽取耐用偏好写入长期记忆(on/off,默认 on;mock 模型下自动关)
# AGENT_PREF_MINING=on

# Skill 预加载(任务开始前自动调用轻量 READ skill;默认 on;大文档 skill 不预加载)
# AGENT_SKILL_PREFETCH=on
# AGENT_SKILL_PREFETCH_MAX_CHARS=2000

# AGENT_CLI_BOX_INDENT=4        # Agent 回复框左缩进(默认 4,越小框越宽)
# AGENT_CLI_PLAIN=1          # CLI 关闭颜色(Agent 黄色/状态栏 dim)
# AGENT_CLI_COLOR=1          # 兼容旧开关(已默认 TTY 下 Agent 黄色)

# Skill 插件目录(可选;默认还会扫描 ~/.agents/skills/)
# AGENT_USER_SKILLS_DIR=~/.agents/skills
# AGENT_SKILLS_DIRS=/path/to/extra/skills:/another/dir

# 个人数据目录(只读索引进长期记忆,冒号分隔多个;支持 ~ 展开)
# AGENT_PERSONAL_DIRS=~/Documents/notes:~/Desktop/docs

# 每日简报:时间 / 渠道(qq|email|wechat|none)/ QQ 投递目标(group:<id> 等)
# AGENT_BRIEFING_AT=08:00
# AGENT_BRIEFING_CHANNEL=qq
# AGENT_BRIEFING_TO=group:你的群ID

# ── 邮件渠道 ──────────────────────────────────────────────────────────────────
# EMAIL_IMAP_HOST=imap.qq.com          # QQ 邮箱: imap.qq.com | 163: imap.163.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.qq.com          # QQ 邮箱: smtp.qq.com | 163: smtp.163.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=your@qq.com
# EMAIL_PASS=授权码(不是登录密码)
# EMAIL_POLL_SEC=30                    # 轮询间隔秒数

# ── 企业微信渠道 ──────────────────────────────────────────────────────────────
# WECHAT_CORP_ID=wx...                 # 企业 ID
# WECHAT_AGENT_ID=1000000             # 自建应用 AgentId
# WECHAT_SECRET=...                    # 应用 Secret
# WECHAT_TOKEN=...                     # 消息接收 Token
# WECHAT_ENCODING_AES_KEY=...          # 消息加密 AES Key(43位)

# ── QQ · 个人号扫码即连(OneBot v11 / NapCat,推荐)──────────────────────────────
# 三步:① bash scripts/napcat-up.sh  ② 浏览器扫码登录QQ  ③ 填下面三行启动(详见 CONNECT_QQ.md)
# ONEBOT_ENABLE=1
# ONEBOT_WS_URL=ws://127.0.0.1:3001
# ONEBOT_ACCESS_TOKEN=与NapCat一致的token
# QQ_MASTER_UIN=你自己的QQ号           # 强烈建议:只听你的指令,防别人在群里驱使

# ── QQ 官方机器人(另一条路:需 q.qq.com 申请 + 公网 webhook)────────────────────
# 也可在 Web「设置 → 频道连接 → QQ」填写,保存到 logs/channels.json
# QQ_BOT_APP_ID=你的AppID
# QQ_BOT_SECRET=你的AppSecret
# QQ_BOT_SANDBOX=0                     # 1=沙箱 0=正式
# AGENT_PUBLIC_URL=https://你的公网域名  # 用于显示完整 webhook 回调地址

# ── Slack Events API ──────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...

# ── 联网搜索(可选,不配则用 DuckDuckGo 免 Key)────────────────────────────────────
# TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=BSA...
# SERPER_API_KEY=...
