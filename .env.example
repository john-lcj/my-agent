# 复制为 .env 并填入真实值。绝不要把 .env 提交到版本库。

# 项目根与数据目录(scripts/launch.sh 会自动 export,一般不用手改)
# AGENT_PROJECT_ROOT=/Users/you/Desktop/my agent
# AGENT_LOG_DIR=/Users/you/Desktop/my agent/logs

# 选择模型 provider:mock(默认,无需 key) / openai / claude / deepseek / ollama / router
AGENT_PROVIDER=mock

# 具体模型 id(优先于 provider): deepseek-v4-flash / deepseek-v4-pro / gpt-4o-mini 等
# AGENT_MODEL=deepseek-v4-flash

# 按权限档分模型(好钢用在刀刃上):可写档(写代码/网页)用强模型,只读档用便宜快的。
# 优先级:AGENT_<档名>_MODEL > 该档 YAML 的 llm > AGENT_MODEL
# AGENT_EXECUTOR_MODEL=deepseek-v4-pro
# AGENT_RESEARCHER_MODEL=deepseek-v4-flash

# 各家 API Key(用哪个填哪个)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# 可选模型名覆盖
# OPENAI_MODEL=gpt-4o-mini
# CLAUDE_MODEL=claude-sonnet-4-20250514
# DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 Ollama(OpenAI 兼容 /v1,需先 ollama serve)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 治理档位:conservative | balanced | aggressive
# AGENT_GOVERNANCE_MODE=balanced

# ── 工作电脑安全加固(P0,强烈建议)──────────────────────────────────────────────
# 工作区根:设了之后 fs.* 读写限制在此目录内,区外访问需确认(STRICT=1 则直接拒绝)。
# 防止提示注入读取/篡改工作区以外的机密文件。不设=不限制(个人机零配置)。
# AGENT_WORKSPACE_ROOT=/Users/you/Desktop/my agent
# AGENT_WORKSPACE_STRICT=0
# 外发邮件收件人白名单(逗号分隔);留空=只允许发给 EMAIL_USER 自己。防被诱导外发机密。
# EMAIL_ALLOWED_RECIPIENTS=

# 开发期在控制台回显 trace
# AGENT_TRACE_ECHO=1

# 交付质检(Cowork 模式下声称完成时额外调一次 LLM;0 关闭省 token,1 开启,默认 1)
# AGENT_CONTENT_JUDGE=0

# 最大步数(防止单任务死循环,默认 20)
# AGENT_MAX_STEPS=20
# AGENT_CAPTAIN_MAX_STEPS=0  # 已废弃;Captain 不再单独限步,由 triage 决定是否派子 agent

# 金额上限(USD),防止烧爆额度;注释掉则无限制
# AGENT_MAX_COST_USD=0.10

# ── 专属化 ────────────────────────────────────────────────────────────────────
# 偏好自动沉淀:会话后抽取耐用偏好写入长期记忆(on/off,默认 on;mock 模型下自动关)
# AGENT_PREF_MINING=on

# Skill 预加载(任务开始前自动调用轻量 READ skill;默认 on;大文档 skill 不预加载)
# AGENT_SKILL_PREFETCH=on
# AGENT_SKILL_PREFETCH_MAX_CHARS=2000

# AGENT_CLI_BOX_INDENT=4        # Agent 回复框左缩进(默认 4,越小框越宽)
# AGENT_CLI_PLAIN=1          # CLI 关闭颜色(Agent 黄色/状态栏 dim)
# AGENT_CLI_COLOR=1          # 兼容旧开关(已默认 TTY 下 Agent 黄色)

# Skill 插件目录(可选;默认还会扫描 ~/.agents/skills/)
# AGENT_USER_SKILLS_DIR=~/.agents/skills
# AGENT_SKILLS_DIRS=/path/to/extra/skills:/another/dir

# 个人数据目录(只读索引进长期记忆,冒号分隔多个;支持 ~ 展开)
# AGENT_PERSONAL_DIRS=~/Documents/notes:~/Desktop/docs

# 每日简报:时间 / 渠道(qq|email|wechat|none)/ QQ 投递目标(group:<id> 等)
# AGENT_BRIEFING_AT=08:00
# AGENT_BRIEFING_CHANNEL=qq
# AGENT_BRIEFING_TO=group:你的群ID

# ── 手机直连网页 UI(经 Tailscale,推荐;详见 CONNECT_PHONE.md)──────────────────
AGENT_WEB_PORT=8000
# 绑到所有网卡 Tailscale 才连得到;AGENT_API_TOKEN 是远程访问密码(手机上输一次)
# AGENT_WEB_HOST=0.0.0.0
# AGENT_API_TOKEN=用 python -c "import secrets;print(secrets.token_urlsafe(24))" 生成一串
# AUTH_SECRET=用 python -c "import secrets;print(secrets.token_urlsafe(32))" 生成一串

# ── 邮件渠道(定时任务产物投递 / 异步对话;也可在 Web「设置 → 邮件」里填)──────────
# EMAIL_IMAP_HOST=imap.qq.com          # QQ 邮箱: imap.qq.com | 163: imap.163.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.qq.com          # QQ 邮箱: smtp.qq.com | 163: smtp.163.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=your@qq.com
# EMAIL_PASS=授权码(不是登录密码)
# EMAIL_POLL_SEC=20                    # 轮询间隔秒数
# EMAIL_ALLOWED_SENDERS=               # 留空=只听自己;多个逗号分隔

# ── 联网搜索(可选,不配则用 DuckDuckGo 免 Key)────────────────────────────────────
# TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=BSA...
# SERPER_API_KEY=...

# ── 文生图 image.generate(可选)────────────────────────────────────────────────
# 【推荐·免费·国内直连】智谱 CogView-3-Flash:bigmodel.cn 注册拿 key,免费额度,几秒出图
# IMAGE_PROVIDER=zhipu
# IMAGE_MODEL=cogview-3-flash
# IMAGE_API_KEY=你的_智谱_key
# 其它后端:
#   Runware(需付费):IMAGE_PROVIDER=runware + IMAGE_MODEL=runware:100@1 + IMAGE_API_KEY
#   OpenAI 兼容(DALL·E 等):IMAGE_PROVIDER=openai + IMAGE_MODEL/IMAGE_BASE_URL/IMAGE_API_KEY

# ── 使用者画像预设(可选)──────────────────────────────────────────────────────
# 按身份切做事侧重:general(通用,默认)/ office(职场办公)/ coder(写代码)
# AGENT_PERSONA_PRESET=general
