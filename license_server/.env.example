# License Server 环境变量示例
# 复制为 .env 并修改后使用：cp .env.example .env

# ── 基础配置 ──────────────────────────────────────
# 管理员 token（务必改为强随机字符串）
ADMIN_TOKEN=change-me-to-strong-random-secret

# 数据库路径（Docker volume 内，一般无需修改）
DB_PATH=/data/license.db

# 端口
PORT=8080

# 每个 key 默认允许激活的最大设备数
MAX_DEVICES=2

# ── 邮件配置（填写后收款自动发授权码）─────────────
# QQ 邮箱示例（需在 QQ 邮箱设置里开启 SMTP 并获取授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=Captain AI

# 163 邮箱示例
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your@163.com
# SMTP_PASS=your-auth-code

# ── 支付平台密钥（选填，填了才验签；不填照样能用，只是不验证来源）
# 虎皮椒（推荐）：https://www.xunhupay.com/
HUPI_KEY=

# 码支付：https://codepay.fateqq.com/
MZF_KEY=
