{
  "name": "github",
  "label": "GitHub",
  "base_url": "https://api.github.com",
  "auth": {"type": "bearer", "secret_ref": "github"},
  "default_headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
  },
  "actions": [
    {
      "name": "me",
      "method": "GET",
      "path": "/user",
      "description": "View the current authenticated user"
    },
    {
      "name": "list_repos",
      "method": "GET",
      "path": "/user/repos",
      "description": "List my repositories",
      "query": ["per_page", "sort", "visibility", "affiliation"]
    },
    {
      "name": "get_repo",
      "method": "GET",
      "path": "/repos/{owner}/{repo}",
      "description": "Get repository details"
    },
    {
      "name": "list_issues",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues",
      "description": "List repository issues",
      "query": ["state", "labels", "per_page"]
    },
    {
      "name": "create_issue",
      "method": "POST",
      "path": "/repos/{owner}/{repo}/issues",
      "description": "Create a repository issue; write action, confirmation required",
      "body": ["title", "body", "labels"]
    }
  ]
}
