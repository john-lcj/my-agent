    "prompt": "法国的首都是哪座城市?一句话回答。",
    "mode": "chat",
    "expect": {"contains": ["巴黎"], "not_capabilities": ["shell.run", "web.search"]}
  },
  {
    "name": "多步推理-鸡兔同笼",
