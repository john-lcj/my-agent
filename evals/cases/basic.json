    "mode": "chat",
    "expect": {"contains": ["23", "12"], "not_capabilities": ["shell.run"]}
  },
  {
    "name": "日期推理",
    "category": "chat-reason",
    "prompt": "如果今天是 2026 年 6 月 22 日星期一,那么 10 天后是几月几日、星期几?",
    "mode": "chat",
    "expect": {"contains": ["7 月 2 日"], "any": ["星期四", "周四"]}
  },
  {
