[
  {
    "name": "算术-直答",
    "category": "chat-reason",
    "prompt": "12 乘以 8 等于多少?只回答数字。",
    "mode": "chat",
    "expect": {"contains": ["96"], "not_capabilities": ["shell.run"]}
  },
  {
    "name": "常识-直答不查",
